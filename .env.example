# FRENVI PRODUCTION BACKEND ENVIRONMENT CONFIGURATION

# Server Port
PORT=5000

# MongoDB Connection String (Paste your MongoDB Atlas or local URI here)
MONGODB_URI=mongodb://localhost:27017/frenvi
MONGODB_URI_FALLBACK=mongodb://127.0.0.1:27017/frenvi

# Cloudinary — outlet photos + brand logos for shifts
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME

# Agora Video Calling API Credentials (From https://console.agora.io/)
AGORA_APP_ID=YOUR_AGORA_APP_ID
AGORA_APP_CERTIFICATE=YOUR_AGORA_APP_CERTIFICATE

# JWT Secret for Secure Tokens
JWT_SECRET=frenvi_secure_jwt_secret_key_2026_prod
# Access token lifetime (app auto-refreshes via refreshToken)
JWT_EXPIRES=7d
# Refresh token lifetime in days (silent renew — no OTP)
JWT_REFRESH_DAYS=90
# Temporary: allow phone= /auth/bootstrap without Bearer. Set false after users upgraded.
ALLOW_PHONE_AUTH=true

# Cashfree Secure ID — DigiLocker KYC (Aadhaar / PAN / Driving Licence)
# sandbox: https://sandbox.cashfree.com/verification
# production: https://api.cashfree.com/verification
CASHFREE_CLIENT_ID=YOUR_CASHFREE_CLIENT_ID
CASHFREE_CLIENT_SECRET=YOUR_CASHFREE_CLIENT_SECRET
CASHFREE_ENV=sandbox
CASHFREE_BASE_URL=https://sandbox.cashfree.com/verification

# DigiLocker redirect + webhooks require a public HTTPS API origin
# Example: https://api.yourdomain.com
PUBLIC_API_BASE_URL=
KYC_MIN_AGE=18
DIGILOCKER_COMPANY_NAME=FRENVI

# Cashfree Payment Gateway (wallet top-up) — separate from Secure ID
# Sandbox (test keys from Merchant Dashboard → Developers → API Keys → Test):
# CASHFREE_PG_ENV=sandbox
# CASHFREE_PG_BASE_URL=https://sandbox.cashfree.com/pg
# CASHFREE_PG_CLIENT_ID=...
# CASHFREE_PG_CLIENT_SECRET=...
# Production (live keys — requires PG account activation / go-live):
CASHFREE_PG_CLIENT_ID=YOUR_CASHFREE_PG_CLIENT_ID
CASHFREE_PG_CLIENT_SECRET=YOUR_CASHFREE_PG_CLIENT_SECRET
CASHFREE_PG_ENV=sandbox
CASHFREE_PG_BASE_URL=https://sandbox.cashfree.com/pg
# Temporary wallet credits when live PG returns "transactions are not enabled"
ALLOW_DEV_WALLET_CREDIT=false

# smslogin.co DLT SMS gateway
SMS_USERNAME=FRENVI
SMS_API_KEY=YOUR_SMS_API_KEY
SMS_SENDER_ID=FRENVI
SMS_API_BASE_URL=https://smslogin.co/v3/api.php
SMS_TEMPLATE_LOGIN_OTP=1707175134658245813
SMS_TEMPLATE_ASSESSMENT_PASS=1707174740300251188
SMS_TEMPLATE_ASSESSMENT_FAIL=1707174860567860796
SMS_TEMPLATE_BOON_ACCEPTED=1707172544770793415
SMS_TEMPLATE_BOON_REMINDER=1707172544255738725
SMS_TEMPLATE_PAYMENT_DONE=1707172544248402828
SMS_TEMPLATE_START_OTP=1707175698863506722
SMS_TEMPLATE_TASK_NEAR_YOU=1707173873682040270
# true = also return otp in API JSON (dev only)
SMS_RETURN_OTP=false

# Doer must be within this many meters of the outlet to unlock start OTP
START_OTP_RADIUS_M=200

# Environment Mode
NODE_ENV=development
